# Verplicht
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
PORT=3000

# Optioneel: timezone voor prompt/context
TIMEZONE=Europe/Amsterdam

# Optioneel: Google Calendar (OAuth refresh-token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optioneel: SMTP voor bevestigingsmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optioneel: Slack notificatie
SLACK_WEBHOOK_URL=
