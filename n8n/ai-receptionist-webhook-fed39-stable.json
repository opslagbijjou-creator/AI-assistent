        "description": "Returns pricing information for services. Input should be the service name or type.",
        "jsCode": "const query = String($input.query || '').toLowerCase();\n\nconst pricing = {\n  consultation: { price: 75, duration: '30 min', description: 'Initial consultation' },\n  standard: { price: 150, duration: '1 hour', description: 'Standard service' },\n  premium: { price: 250, duration: '1.5 hours', description: 'Premium service package' },\n  enterprise: { price: 500, duration: '2 hours', description: 'Enterprise solution' }\n};\n\nfor (const [key, value] of Object.entries(pricing)) {\n  if (query.includes(key)) {\n    return `${value.description}: €${value.price} for ${value.duration}`;\n  }\n}\n\nreturn 'Available services: Consultation (€75), Standard (€150), Premium (€250), Enterprise (€500). Please specify which service you are interested in.';"
      },
